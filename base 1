        // 4. AUTHENTICATION CONTROLLER (Feature 1)
        function updateAuthUI() {
            if (currentUser) {
                document.getElementById('userBadge').classList.remove('hidden');
                document.getElementById('userBadgeName').textContent = `${currentUser.username} (${currentUser.occupation || 'Rider'})`;
                document.getElementById('authBtn').textContent = "Log Out";
                document.getElementById('authBtn').setAttribute('onclick', 'logoutUser()');
            } else {
                document.getElementById('userBadge').classList.add('hidden');
                document.getElementById('authBtn').textContent = "Sign In / Sign Up";
                document.getElementById('authBtn').setAttribute('onclick', 'openAuthModal()');
            }
        }

        function openAuthModal() {
            document.getElementById('authModal').classList.remove('hidden');
        }

        function closeAuthModal() {
            document.getElementById('authModal').classList.add('hidden');
            document.getElementById('authAlert').classList.add('hidden');
        }

        function switchAuthTab(tab) {
            const siForm = document.getElementById('signInForm');
            const suForm = document.getElementById('signUpForm');
            const tabSi = document.getElementById('tabSignIn');
            const tabSu = document.getElementById('tabSignUp');

            if (tab === 'signin') {
                siForm.classList.remove('hidden');
                suForm.classList.add('hidden');
                tabSi.className = "flex-1 pb-3 text-sm font-semibold border-b-2 border-cyan-500 text-cyan-400";
                tabSu.className = "flex-1 pb-3 text-sm font-semibold border-b-2 border-transparent text-gray-400 hover:text-white";
            } else {
                siForm.classList.add('hidden');
                suForm.classList.remove('hidden');
                tabSu.className = "flex-1 pb-3 text-sm font-semibold border-b-2 border-emerald-500 text-emerald-400";
                tabSi.className = "flex-1 pb-3 text-sm font-semibold border-b-2 border-transparent text-gray-400 hover:text-white";
            }
        }

        function handleSignUp(e) {
            e.preventDefault();
            const username = document.getElementById('suUsername').value.trim();
            const password = document.getElementById('suPassword').value.trim();
            const phone = document.getElementById('suPhone').value.trim();
            const occupation = document.getElementById('suOccupation').value.trim();

            if (usersDB.some(u => u.username.toLowerCase() === username.toLowerCase())) {
                showAuthAlert("Username already exists. Please pick another.", "error");
                return;
            }

            const newUser = { username, password, phone, occupation };
            usersDB.push(newUser);
            localStorage.setItem('tg_users', JSON.stringify(usersDB));
            currentUser = newUser;
            localStorage.setItem('tg_cur_user', JSON.stringify(currentUser));
            
            showAuthAlert("Account created successfully! Signed in.", "success");
            setTimeout(() => {
                closeAuthModal();
                updateAuthUI();
            }, 800);
        }

        function handleSignIn(e) {
            e.preventDefault();
            const username = document.getElementById('siUsername').value.trim();
            const password = document.getElementById('siPassword').value.trim();

            const matched = usersDB.find(u => u.username === username && u.password === password);
            if (matched) {
                currentUser = matched;
                localStorage.setItem('tg_cur_user', JSON.stringify(currentUser));
                showAuthAlert("Login successful!", "success");
                setTimeout(() => {
                    closeAuthModal();
                    updateAuthUI();
                }, 700);
            } else {
                showAuthAlert("Invalid username or password. Please verify.", "error");
            }
        }

        function logoutUser() {
            currentUser = null;
            localStorage.removeItem('tg_cur_user');
            updateAuthUI();
        }

