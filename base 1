            const el = document.getElementById('authAlert');
            el.classList.remove('hidden');
            el.textContent = msg;
            el.className = type === 'error' ? 
                'mt-3 text-xs text-center text-rose-400 bg-rose-950/80 p-2 rounded border border-rose-800' : 
                'mt-3 text-xs text-center text-emerald-400 bg-emerald-950/80 p-2 rounded border border-emerald-800';
        }

        // 5. RAPIDO ROUTING & DEDICATED BUS AVAILABILITY (Features 2, 3, 4)
        let selectedBusForBooking = null;

        function checkBusAvailability() {
            const pickup = document.getElementById('pickupSelect').value;
            const drop = document.getElementById('dropSelect').value;

            if (!pickup || !drop) {
                alert("Please select both Pickup and Drop locations.");
                return;
            }

            if (pickup === drop) {
                alert("Pickup and Drop locations cannot be the same.");
                return;
            }

            // Find matching unique route
            const matches = ROUTE_REGISTRY.filter(r => r.pickup === pickup && r.drop === drop);

            const placeholder = document.getElementById('resultsPlaceholder');
            const busResultsCard = document.getElementById('busResultsCard');
            const busList = document.getElementById('busCardsList');
            const routeTag = document.getElementById('routeBadgeTag');
            const crowdSection = document.getElementById('crowdPreferenceSection');

            crowdSection.classList.add('hidden');

            if (matches.length === 0) {
                // Feature 3: Pop up "NO BUS FOUND" if no route exists
                placeholder.classList.remove('hidden');
                busResultsCard.classList.add('hidden');
                alert(`NO BUS FOUND for route: ${pickup} \u2192 ${drop}\nPlease check alternative hubs.`);
                return;
            }

            placeholder.classList.add('hidden');
            busResultsCard.classList.remove('hidden');
            routeTag.innerHTML = `${pickup.toUpperCase()} &rarr; ${drop.toUpperCase()}`;
            busList.innerHTML = '';

            matches.forEach(bus => {
                const card = document.createElement('div');
                card.className = "p-5 rounded-2xl bg-gray-900 border border-gray-700/80 hover:border-cyan-500 transition cursor-pointer shadow-lg";
                card.onclick = () => chooseBusForJourney(bus);

                card.innerHTML = `
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="px-2.5 py-1 bg-cyan-950 border border-cyan-800 text-cyan-300 font-mono text-xs font-bold rounded">
