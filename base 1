            const txt = document.getElementById('feedbackText');
            fb.classList.remove('hidden');

            if (type === 'NON_CROWDED') {
                txt.innerHTML = `Selected <strong>Non-Crowded Bus</strong> on <strong>${selectedBusForBooking.busName} (${selectedBusForBooking.busNumber})</strong>. Priority boarding voucher configured.`;
            } else {
                txt.innerHTML = `Selected <strong>Crowded Bus Option</strong> on <strong>${selectedBusForBooking.busName} (${selectedBusForBooking.busNumber})</strong>. Standby boarding pass configured.`;
            }
        }

        function confirmTrip() {
            if (!currentUser) {
                alert("Please Sign In or Sign Up first to finalize your trip reservation.");
                openAuthModal();
                return;
            }
            alert(`Booking confirmed for ${currentUser.username}!\nBus: ${selectedBusForBooking.busName} [${selectedBusForBooking.busNumber}]\nDeparture Stop: ${selectedBusForBooking.pickup}\nDestination: ${selectedBusForBooking.drop}`);
            document.getElementById('crowdPreferenceSection').classList.add('hidden');
        }

        // 7. TRANSITGUARD AI QR INCIDENT REPORTING
        function submitPassengerIncident(reason) {
            transitGuardMetrics.reportsCount += 1;
            const lb = parseInt(document.getElementById('leftBehindCount').value) || 3;
            transitGuardMetrics.leftBehindEstimate += lb;
            transitGuardMetrics.confirmedEvents += 1;

            recomputeCoreMetrics();
            alert(`TransitGuard Telemetry Logged:\nStop: T. Nagar\nReason: ${reason}\nEstimated Left Behind: ${lb}\nTrust Level: HIGH (Confirmed)`);
            renderRiskTable();
        }

        function triggerSimulatedFlood() {
            transitGuardMetrics.reportsCount += 30;
            transitGuardMetrics.leftBehindEstimate += 85;
            transitGuardMetrics.confirmedEvents += 8;

            recomputeCoreMetrics();
            alert("Flood Simulation Complete: 30 unique mobile passenger devices reported failed boarding at T. Nagar within 10 minutes. RSFS spiked.");
            renderRiskTable();
        }

        // 8. TRANSITGUARD AI CORE METRICS CALCULATION
        function recomputeCoreMetrics() {
            // Unmet Boarding Demand (UBD) = (left_behind / total_waiting) * 100
            const totalWaiting = transitGuardMetrics.leftBehindEstimate + 120;
            const ubd = ((transitGuardMetrics.leftBehindEstimate / totalWaiting) * 100).toFixed(1);

            // Stranded Passenger Minutes (SPM) = sum(left_behind * wait_time)
            const spm = transitGuardMetrics.leftBehindEstimate * 14; 

            // RSFS = (Confirmed Med/High events / scheduled arrivals) * 100
            const rsfs = ((transitGuardMetrics.confirmedEvents / transitGuardMetrics.scheduledArrivals) * 100).toFixed(1);

            document.getElementById('metricTotalReports').textContent = transitGuardMetrics.reportsCount;
            document.getElementById('metricLeftBehind').textContent = transitGuardMetrics.leftBehindEstimate;
            document.getElementById('metricConfirmedEvents').textContent = transitGuardMetrics.confirmedEvents;

            document.getElementById('valUBD').textContent = `${ubd}%`;
            document.getElementById('valSPM').innerHTML = `${spm.toLocaleString()} <span class="text-xs text-gray-400 font-normal">pax-mins</span>`;
            document.getElementById('valRSFS').textContent = `${rsfs}%`;
        }

        function renderRiskTable() {
            const tbody = document.getElementById('riskTableBody');
            tbody.innerHTML = '';

            predictedStopsData.forEach(row => {
                const tr = document.createElement('tr');
                const riskColor = row.risk === 'High' ? 'text-rose-400 bg-rose-950/40 border border-rose-800' :
                                 row.risk === 'Medium' ? 'text-amber-400 bg-amber-950/40 border border-amber-800' :
                                 'text-emerald-400 bg-emerald-950/40 border border-emerald-800';
                
                tr.innerHTML = `
                    <td class="p-3 font-mono font-bold text-white">${row.route}</td>
                    <td class="p-3 font-medium">${row.stop}</td>
                    <td class="p-3"><span class="px-2 py-0.5 rounded font-mono text-[10px] ${riskColor}">${row.risk}</span></td>
                    <td class="p-3 font-mono">${row.waiting}</td>
                    <td class="p-3 font-mono">${row.freeCap}</td>
                    <td class="p-3 font-mono font-bold ${row.shortfall > 0 ? 'text-rose-400' : 'text-gray-400'}">${row.shortfall > 0 ? '+' + row.shortfall : '0'}</td>
                    <td class="p-3 font-mono text-[10px] text-cyan-400">${row.source}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function inspectStop(stopName) {
            document.getElementById('inspectedStopTitle').textContent = `Stop Inspector: ${stopName}`;
            if (stopName === 'T. Nagar') {
                document.getElementById('inspectedStopBadge').className = "text-xs px-2 py-0.5 rounded font-mono font-bold bg-rose-950 text-rose-400 border border-rose-800";
                document.getElementById('inspectedStopBadge').textContent = "HIGH RISK";
                document.getElementById('inspectedRoute').textContent = "M21 (Peak Express)";
                document.getElementById('inspectedTrust').textContent = "HIGH (4+ devices validated within 10m)";
                document.getElementById('inspectedWaiting').textContent = "68 passengers";
                document.getElementById('inspectedCapacity').textContent = "12 seats";
                document.getElementById('inspectedShortfall').textContent = "+56 Passengers";
            } else if (stopName === 'Guindy') {
                document.getElementById('inspectedStopBadge').className = "text-xs px-2 py-0.5 rounded font-mono font-bold bg-amber-950 text-amber-400 border border-amber-800";
                document.getElementById('inspectedStopBadge').textContent = "MEDIUM RISK";
                document.getElementById('inspectedRoute').textContent = "47A (Guindy Link)";
                document.getElementById('inspectedTrust').textContent = "MEDIUM (3 devices)";
                document.getElementById('inspectedWaiting').textContent = "32 passengers";
                document.getElementById('inspectedCapacity').textContent = "26 seats";
                document.getElementById('inspectedShortfall').textContent = "+6 Passengers";
            } else {
                document.getElementById('inspectedStopBadge').className = "text-xs px-2 py-0.5 rounded font-mono font-bold bg-emerald-950 text-emerald-400 border border-emerald-800";
                document.getElementById('inspectedStopBadge').textContent = "LOW RISK";
                document.getElementById('inspectedRoute').textContent = "KA-4001 / Suburban";
                document.getElementById('inspectedTrust').textContent = "NORMAL SCHEDULE";
                document.getElementById('inspectedWaiting').textContent = "18 passengers";
                document.getElementById('inspectedCapacity').textContent = "40 seats";
                document.getElementById('inspectedShortfall').textContent = "0 Shortfall";
            }
        }

        function applyStopAction(action) {
            alert(`Transit Authority Action Executed: Emergency Shuttle dispatched to inspected location. Depot fleet updated.`);
        }

        // 9. INTERVENTION SIMULATOR (Step 10)
        function updateSimulatorSlider(val) {
            document.getElementById('simulatorBusDisplay').textContent = `${val} extra buses`;
        }

        function runInterventionSimulator() {
            const extraBuses = parseInt(document.getElementById('simulatorBusRange').value);
            const depotRemaining = 6 - extraBuses;
            document.getElementById('depotAvailableCount').textContent = depotRemaining;

            const extraSeats = extraBuses * 50;
            const newCap = 50 + extraSeats;
            const newShortfall = Math.max(0, 56 - extraSeats);
            const newUBD = ((newShortfall / (68 + 10)) * 100).toFixed(1);
            const spmSaved = extraBuses * 420;

            document.getElementById('simResultCap').textContent = `${newCap} Seats`;
            document.getElementById('simResultShortfall').textContent = newShortfall;
            document.getElementById('simResultUBD').textContent = `${newUBD}%`;
            document.getElementById('simResultSPMSaved').textContent = `-${spmSaved} pax-mins`;
        }

        function resetSimData() {
            transitGuardMetrics.reportsCount = 42;
            transitGuardMetrics.leftBehindEstimate = 114;
            transitGuardMetrics.confirmedEvents = 18;
            recomputeCoreMetrics();
            renderRiskTable();
        }

        // 10. VIEW SWITCHER
        let currentView = 'passenger';
        function toggleView() {
            if (currentView === 'passenger') {
                document.getElementById('passengerView').classList.add('hidden');
                document.getElementById('authorityView').classList.remove('hidden');
                document.getElementById('viewToggleLabel').textContent = "Passenger App";
                currentView = 'authority';
            } else {
                document.getElementById('authorityView').classList.add('hidden');
                document.getElementById('passengerView').classList.remove('hidden');
                document.getElementById('viewToggleLabel').textContent = "Authority Dashboard";
                currentView = 'passenger';
            }
        }

        // Initial setup on load
        window.addEventListener('DOMContentLoaded', () => {
            updateAuthUI();
            recomputeCoreMetrics();
            renderRiskTable();
        });
    </script>
</body>
</html>

Key Technical Implementations

1.  Authentication (Feature 1):

      - Sign Up: Collects username, password, phone number, and occupation.
        Validates uniqueness and stores user profiles in browser persistent
        memory (localStorage).
      - Sign In: Strictly checks username and password against the sign-up
        database, establishing an active session badge in the header.

2.  Rapido-Style Journey Planner (Feature 2):

      - Clean, high-contrast pickup/drop selectors modeled after transit apps
        with live validation to prevent duplicate coordinates.

3.  Dedicated Fleet Registry & "NO BUS FOUND" Engine (Features 3 & 4):

      - Bus numbers are strictly unique to specific origin-destination pairs
        (e.g., TN-01-KA-4001 runs only Chennai Central \leftrightarrow Bangalore
        Majestic, while TN-38-CT-9022 runs Chennai Central \leftrightarrow
        Coimbatore).
      - If an unserviced route is queried, the system pops up the "NO BUS FOUND"
        alert.

4.  Crowded vs. Non-Crowded Selection (Feature 5):

      - When a bus is selected, Step 5 presents interactive cards showing
        occupancy percentages, standing probabilities, and shortfall risks so
        riders can choose between a Guaranteed Seat (Non-Crowded) and Express
        Standby (Crowded).

5.  TransitGuard AI System:

      - Passenger Incident Portal: Allows QR-code simulation (I COULD NOT BOARD,
        BUS IS FULL, BUS IS LATE) with optional left-behind passenger counters
        and a 30-device flood simulator.
      - Formulas Implemented:
          - \text{UBD} = \left(\frac{\text{Left Behind}}{\text{Passengers at Stop}}\right) \times 100
          - \text{SPM} = \sum (\text{Left Behind} \times \text{Extra Wait Minutes})
          - \text{RSFS} = \left(\frac{\text{Medium/High Confirmed Events}}{\text{Scheduled Arrivals}}\right) \times 100
      - Intervention Simulator: Dynamically tests extra bus allocation within
        depot fleet limits and computes real-time before/after metrics for
        Capacity, Shortfall, UBD, and Stranded Passenger Minutes saved.
