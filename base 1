                                </span>
                                <span class="text-xs text-gray-400 font-mono">${bus.type}</span>
                            </div>
                            <h4 class="text-lg font-black text-white mt-1.5">${bus.busName}</h4>
                            <p class="text-xs text-gray-400">Assigned Depot: <span class="text-gray-300 font-medium">${bus.depotAssigned}</span></p>
                        </div>

                        <div class="flex items-center gap-4 text-right">
                            <div>
                                <div class="text-xs font-mono text-gray-400">Frequency</div>
                                <div class="text-sm font-bold text-emerald-400">${bus.frequency}</div>
                            </div>
                            <button class="px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-bold rounded-xl transition">
                                Select Bus
                            </button>
                        </div>
                    </div>
                `;
                busList.appendChild(card);
            });
